---
import { projects, hasPlaceholderProjects } from "../data/projects";
import type { Project } from "../data/projects";

interface Props {
  /** Limit the number of cards shown (homepage uses a subset). */
  limit?: number;
  heading?: string;
  eyebrow?: string;
}
const { limit, heading = "Selected project work", eyebrow = "Portfolio" } = Astro.props;

const list: Project[] = typeof limit === "number" ? projects.slice(0, limit) : projects;
---

<section class="section" aria-labelledby="projects-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="projects-heading">{heading}</h2>
    </div>

    {hasPlaceholderProjects && (
      <p class="notice notice--warning" style="margin-bottom: 1.75rem;" role="note">
        <span>
          <strong>Placeholder portfolio.</strong>
          These tiles are layout samples only. The site owner must replace them with real
          completed-project names and photographs before launch — nothing here represents
          finished Disha Associates work.
        </span>
      </p>
    )}

    <div class="grid grid--3">
      {list.map((project) => (
        <article class="card">
          <div class="card__media-wrap">
            {project.placeholder && <span class="card__badge">Sample layout</span>}
            <div class="card__media">
              <img
                src={project.images[0]}
                width="1600"
                height="900"
                alt={project.imageAlt}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <div class="card__body">
            <p class="eyebrow" style="margin-bottom: 0.35rem;">{project.type}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            {project.scale || project.materials ? (
              <dl class="meta-strip" style="padding: 0.9rem; gap: 0.9rem;">
                {project.scale && (
                  <div>
                    <dt>Scale</dt>
                    <dd>{project.scale}</dd>
                  </div>
                )}
                {project.materials && (
                  <div>
                    <dt>Materials</dt>
                    <dd>{project.materials}</dd>
                  </div>
                )}
              </dl>
            ) : null}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
