---
import { whyChoose } from "../data/benefits";
import Icon from "./Icon.astro";

interface Props {
  heading?: string;
  eyebrow?: string;
}
const { heading = "Why clients work with Disha Associates", eyebrow = "Why choose us" } = Astro.props;
---

<section class="section section--gray" aria-labelledby="why-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="why-heading">{heading}</h2>
    </div>
    <div class="grid grid--3">
      {whyChoose.map((item) => (
        <div class="feature">
          <span class="feature__icon"><Icon name={item.icon} size={22} /></span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
